# 应用配置
APP_NAME=SuperBizAgent
DEBUG=false
HOST=0.0.0.0
PORT=9900

# DashScope 配置
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4

#DeepSeek
DEEPSEEK_API_KEY=xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Milvus 配置
# 🔴 原来是 localhost —— 容器里的 localhost 指的是【容器自己】，不是虚拟机。
#    Milvus 跑在第 1 步的 milvus_db 容器里，所以这里必须写虚拟机的内网 IP。
#    用它而不是公网 IP：公网 IP 需要 NAT 回流（hairpin NAT），阿里云默认不支持。
#    （Milvus 的 19530 已经在第 1 步的 compose 里映射到宿主机了）
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_TOP_K=3
RAG_MODEL=qwen-max

# 文档分块配置
CHUNK_MAX_SIZE=800
CHUNK_OVERLAP=100

# MCP 服务配置
# 支持的 transport 类型：stdio、sse（腾讯云等 /sse/ 端点）、streamable-http（本地 FastMCP）
# 也可以配置真实的cls mcp服务： https://cloud.tencent.com/developer/mcp/server/11710
# MCP_CLS_TRANSPORT=sse
# MCP_CLS_URL=https://mcp-api.tencent-cloud.com/sse/xxxx
#
# 🔴 这两个 localhost 是【对的，不要改】——
#    两个 MCP 服务和 FastAPI 主应用跑在【同一个容器】里（见 Dockerfile 的 CMD），
#    同一个网络命名空间，所以 localhost 指向的就是它们自己。
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp

# Prometheus（告警查询工具等）
# 🔴 同 Milvus：Prometheus 是【另一个容器】，容器内写 localhost 连不到。
#    它的 9190 已经映射到宿主机，所以走虚拟机内网 IP。
#    （宿主机 9090 被别的服务占用，所以 Prometheus 映射在 9190）
PROMETHEUS_BASE_URL=http://:9190
PROMETHEUS_REQUEST_TIMEOUT=10.0

# 通知配置（钉钉机器人：加签模式）
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
WECOM_WEBHOOK_URL=

# 通知卡片上按钮指向的地址 —— 用公网地址，别人点了才能打开
# 🔴 原来是 http://:9090（那是 Prometheus 的端口，不对）
#    走 nginx 的 80 端口才对
APP_URL=http://
